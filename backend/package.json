{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:money-conformance": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runTestsByPath src/__tests__/moneyConformance.test.ts",
    "docs:check": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runTestsByPath src/__tests__/apiReference.test.ts src/__tests__/domainStateMachineDocs.test.ts src/__tests__/securityRegisterDocs.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "npm run migrate:up",
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:contract:up": "node-pg-migrate up -m migrations-contract --migrations-table pgmigrations_contract",
    "migrate:contract:down": "node-pg-migrate down -m migrations-contract --migrations-table pgmigrations_contract",
    "_migrations_note": "Single source of truth: backend/migrations/*.js (node-pg-migrate). Do NOT add .sql files to src/db/ — they are not executed by any script.",
    "seed": "npm run seed:dev",
    "seed:dev": "tsx src/seed/index.ts",
    "seed:reset": "tsx src/seed/index.ts --reset",
    "seed:scenario": "tsx src/seed/index.ts --scenario",
    "seed:list": "tsx src/seed/index.ts --list"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.45.0",
    "@stellar/stellar-sdk": "^14.5.0",
    "@types/node-cron": "^3.0.11",
    "apollo-server-express": "^3.13.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-graphql": "^0.12.0",
    "express-rate-limit": "^8.2.1",
    "graphql": "^17.0.2",
    "graphql-tools": "^9.0.34",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.18.0",
    "prom-client": "^15.1.3",
    "redis": "^5.11.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.4.2",
    "jest-util": "^30.4.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "eslintConfig": {},
  "overrides": {
    "axios": "1.13.5"
  }
}
