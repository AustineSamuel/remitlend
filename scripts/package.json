{
  "name": "remitlend-scripts",
  "version": "1.0.0",
  "description": "Deployment and maintenance scripts for RemitLend contracts",
  "main": "index.js",
  "scripts": {
    "deploy": "ts-node deploy.ts",
    "typecheck": "tsc --noEmit",
    "gen:money": "ts-node gen-money.ts",
    "gen:money:check": "ts-node gen-money.ts --check",
    "money:property-test": "tsx money-property-test.ts",
    "money:conformance": "tsx check-money-conformance.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1",
    "dotenv": "^18.0.8",
    "fs-extra": "^11.4.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "axios": "1.13.5"
  }
}