    },
    {
      "id": "bounded_sub-out-of-bounds",
      "asset_precision": 7,
      "operation": "bounded_sub",
      "inputs": { "a": "0", "b": "1", "min": "0", "max": "100" },
      "expected": { "error": "ERR_OUT_OF_BOUNDS" }
    },
    {
      "id": "bounded_sub-overflow",
      "asset_precision": 7,
      "operation": "bounded_sub",
      "inputs": {
        "a": "-170141183460469231731687303715884105728",
        "b": "1",
        "min": "-170141183460469231731687303715884105728",
        "max": "0"
      },
      "expected": { "error": "ERR_OVERFLOW" }
    },
    {
      "id": "mul_div-zero",
