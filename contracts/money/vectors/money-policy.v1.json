{
  "version": 1,
  "description": "Canonical money policy conformance vectors shared by contracts/money (Rust) and backend/src/money/decimal.ts (TypeScript). All numeric values are decimal strings so i128 values survive JSON round-trips. Each vector has an id, asset_precision (integer decimal places), operation, operation inputs, and expected result (ok + result string, or error + stable error code).",
  "operations": {
    "round_div": {
      "inputs": ["numerator", "denominator"],
      "description": "Divide numerator by denominator with half-to-even rounding, returning an integer decimal string."
    },
    "to_stroops": {
      "inputs": ["amount"],
      "description": "Convert a decimal amount string to integer minor units (stroops) at asset_precision."
    },
    "from_stroops": {
      "inputs": ["stroops"],
      "description": "Convert integer minor units (stroops) to a decimal amount string at asset_precision."
    },
    "split_pro_rata": {
      "inputs": ["total", "weights"],
      "description": "Split total pro-rata by weights (array of decimal strings), returning an array of integer decimal strings that sum exactly to total."
    },
    "bounded_add": {
      "inputs": ["a", "b", "min", "max"],
      "description": "Add a and b, rejecting results outside [min, max]."
    },
    "bounded_sub": {
      "inputs": ["a", "b", "min", "max"],
      "description": "Subtract b from a, rejecting results outside [min, max]."
    },
    "mul_div": {
      "inputs": ["a", "b", "denominator"],
      "description": "Compute (a * b) / denominator with half-to-even rounding, rejecting overflow."
    }
  },
  "error_codes": {
    "ERR_UNSUPPORTED_PRECISION": "asset_precision is not in the supported set (must be 1..=18).",
    "ERR_OVERFLOW": "result does not fit in i128.",
    "ERR_DIVISION_BY_ZERO": "denominator is zero.",
    "ERR_INVALID_SIGN": "negative value where sign is disallowed.",
    "ERR_INVALID_SCALE": "amount has more fractional digits than asset_precision, or malformed decimal string.",
    "ERR_OUT_OF_BOUNDS": "result outside [min, max].",
    "ERR_EMPTY_WEIGHTS": "weights array is empty or sums to zero."
  },
  "vectors": [
    {
      "id": "round_div-zero-numerator",
      "asset_precision": 7,
      "operation": "round_div",
      "inputs": { "numerator": "0", "denominator": "3" },
      "expected": { "ok": "0" }
    },
    {
      "id": "round_div-one-minor-unit",
      "asset_precision": 7,
      "operation": "round_div",
      "inputs": { "numerator": "1", "denominator": "1" },
      "expected": { "ok": "1" }
    },
    {
      "id": "round_div-half-even-down",
      "asset_precision": 7,
      "operation": "round_div",
      "inputs": { "numerator": "5", "denominator": "2" },
      "expected": { "ok": "2" }
    },
    {
      "id": "round_div-half-even-up",
      "asset_precision": 7,
      "operation": "round_div",
      "inputs": { "numerator": "7", "denominator": "2" },
      "expected": { "ok": "4" }
    },
    {
      "id": "round_div-half-even-negative-down",
      "asset_precision": 7,
      "operation": "round_div",
      "inputs": { "numerator": "-5", "denominator": "2" },
      "expected": { "ok": "-2" }
    },
    {
      "id": "round_div-half-even-negative-up",
      "asset_precision": 7,
      "operation": "round_div",
      "inputs": { "numerator": "-7", "denominator": "2" },
      "expected": { "ok": "-4" }
    },
    {
      "id": "round_div-division-by-zero",
      "asset_precision": 7,
      "operation": "round_div",
      "inputs": { "numerator": "1", "denominator": "0" },
      "expected": { "error": "ERR_DIVISION_BY_ZERO" }
    },
    {
      "id": "round_div-max-i128",
      "asset_precision": 7,
      "operation": "round_div",
      "inputs": { "numerator": "170141183460469231731687303715884105727", "denominator": "1" },
      "expected": { "ok": "170141183460469231731687303715884105727" }
    },
    {
      "id": "round_div-min-i128",
      "asset_precision": 7,
      "operation": "round_div",
      "inputs": { "numerator": "-170141183460469231731687303715884105728", "denominator": "1" },
      "expected": { "ok": "-170141183460469231731687303715884105728" }
    },
    {
      "id": "to_stroops-zero",
      "asset_precision": 7,
      "operation": "to_stroops",
      "inputs": { "amount": "0" },
      "expected": { "ok": "0" }
    },
    {
      "id": "to_stroops-one-minor-unit",
      "asset_precision": 7,
      "operation": "to_stroops",
      "inputs": { "amount": "0.0000001" },
      "expected": { "ok": "1" }
    },
    {
      "id": "to_stroops-whole",
      "asset_precision": 7,
      "operation": "to_stroops",
      "inputs": { "amount": "1" },
      "expected": { "ok": "10000000" }
    },
    {
      "id": "to_stroops-max",
      "asset_precision": 7,
      "operation": "to_stroops",
      "inputs": { "amount": "17014118346046923173168730371588.4105727" },
      "expected": { "ok": "170141183460469231731687303715884105727" }
    },
    {
      "id": "to_stroops-overflow",
      "asset_precision": 7,
      "operation": "to_stroops",
      "inputs": { "amount": "17014118346046923173168730371588.4105728" },
      "expected": { "error": "ERR_OVERFLOW" }
    },
    {
      "id": "to_stroops-invalid-scale",
      "asset_precision": 7,
      "operation": "to_stroops",
      "inputs": { "amount": "0.00000001" },
      "expected": { "error": "ERR_INVALID_SCALE" }
    },
    {
      "id": "to_stroops-invalid-sign",
      "asset_precision": 7,
      "operation": "to_stroops",
      "inputs": { "amount": "-1" },
      "expected": { "error": "ERR_INVALID_SIGN" }
    },
    {
      "id": "to_stroops-unsupported-precision-zero",
      "asset_precision": 0,
      "operation": "to_stroops",
      "inputs": { "amount": "1" },
      "expected": { "error": "ERR_UNSUPPORTED_PRECISION" }
    },
    {
      "id": "to_stroops-unsupported-precision-nineteen",
      "asset_precision": 19,
      "operation": "to_stroops",
      "inputs": { "amount": "1" },
      "expected": { "error": "ERR_UNSUPPORTED_PRECISION" }
    },
    {
      "id": "from_stroops-zero",
      "asset_precision": 7,
