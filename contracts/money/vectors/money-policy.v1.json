      "asset_precision": 7,
      "operation": "from_stroops",
      "inputs": { "stroops": "1" },
      "expected": { "ok": "0.0000001" }
    },
    {
      "id": "from_stroops-whole",
      "asset_precision": 7,
      "operation": "from_stroops",
      "inputs": { "stroops": "10000000" },
      "expected": { "ok": "1" }
    },
    {
      "id": "from_stroops-max",
      "asset_precision": 7,
      "operation": "from_stroops",
      "inputs": { "stroops": "170141183460469231731687303715884105727" },
      "expected": { "ok": "17014118346046923173168730371588.4105727" }
    },
    {
      "id": "from_stroops-invalid-sign",
      "asset_precision": 7,
      "operation": "from_stroops",
      "inputs": { "stroops": "-1" },
      "expected": { "error": "ERR_INVALID_SIGN" }
    },
    {
      "id": "from_stroops-unsupported-precision-zero",
      "asset_precision": 0,
      "operation": "from_stroops",
      "inputs": { "stroops": "1" },
      "expected": { "error": "ERR_UNSUPPORTED_PRECISION" }
    },
    {
      "id": "from_stroops-unsupported-precision-nineteen",
      "asset_precision": 19,
      "operation": "from_stroops",
      "inputs": { "stroops": "1" },
      "expected": { "error": "ERR_UNSUPPORTED_PRECISION" }
    },
    {
      "id": "split_pro_rata-zero-total",
      "asset_precision": 7,
      "operation": "split_pro_rata",
      "inputs": { "total": "0", "weights": ["1", "1", "1"] },
      "expected": { "ok": ["0", "0", "0"] }
    },
    {
      "id": "split_pro_rata-one-minor-unit",
      "asset_precision": 7,
      "operation": "split_pro_rata",
      "inputs": { "total": "1", "weights": ["1", "1", "1"] },
      "expected": { "ok": ["1", "0", "0"] }
    },
    {
      "id": "split_pro_rata-even",
      "asset_precision": 7,
      "operation": "split_pro_rata",
      "inputs": { "total": "100", "weights": ["1", "1", "1", "1"] },
      "expected": { "ok": ["25", "25", "25", "25"] }
    },
    {
      "id": "split_pro_rata-remainder",
      "asset_precision": 7,
      "operation": "split_pro_rata",
      "inputs": { "total": "10", "weights": ["1", "1", "1"] },
      "expected": { "ok": ["4", "3", "3"] }
    },
    {
      "id": "split_pro_rata-empty-weights",
      "asset_precision": 7,
      "operation": "split_pro_rata",
      "inputs": { "total": "10", "weights": [] },
      "expected": { "error": "ERR_EMPTY_WEIGHTS" }
    },
    {
      "id": "split_pro_rata-zero-weights",
      "asset_precision": 7,
      "operation": "split_pro_rata",
      "inputs": { "total": "10", "weights": ["0", "0"] },
      "expected": { "error": "ERR_EMPTY_WEIGHTS" }
    },
    {
      "id": "bounded_add-zero",
      "asset_precision": 7,
      "operation": "bounded_add",
      "inputs": { "a": "0", "b": "0", "min": "0", "max": "100" },
      "expected": { "ok": "0" }
    },
    {
      "id": "bounded_add-one-minor-unit",
      "asset_precision": 7,
      "operation": "bounded_add",
      "inputs": { "a": "0", "b": "1", "min": "0", "max": "100" },
