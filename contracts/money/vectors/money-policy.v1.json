    },
    {
      "id": "bounded_add-out-of-bounds",
      "asset_precision": 7,
      "operation": "bounded_add",
      "inputs": { "a": "50", "b": "51", "min": "0", "max": "100" },
      "expected": { "error": "ERR_OUT_OF_BOUNDS" }
    },
    {
      "id": "bounded_add-overflow",
      "asset_precision": 7,
      "operation": "bounded_add",
      "inputs": {
        "a": "170141183460469231731687303715884105727",
        "b": "1",
        "min": "0",
        "max": "170141183460469231731687303715884105727"
      },
      "expected": { "error": "ERR_OVERFLOW" }
    },
    {
      "id": "bounded_sub-zero",
      "asset_precision": 7,
